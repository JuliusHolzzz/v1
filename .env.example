# Supabase (required for leaderboard, lobbies, accounts)
# Vercel + Supabase integration usually sets NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# aliases also supported:
# SUPABASE_SERVICE_KEY=your_service_role_key_here

# JWT for /api/players/register and /api/players/login
JWT_SECRET=change_me_to_a_long_random_string

# Local dev only (Vercel sets PORT automatically)
PORT=3000
